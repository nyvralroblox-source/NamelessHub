local BoostConfig = {
	WalkSpeedEnabled = false,
	WalkSpeedValue = 32,
	JumpPowerEnabled = false,
	JumpPowerValue = 100
}

local BoostOriginalWalkSpeed = 16
local BoostOriginalJumpPower = 50
local BoostOriginalFriction = 0.3
local BoostConnection = nil

local function ApplyBoost()
	local character = LocalPlayer.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	if BoostConfig.WalkSpeedEnabled then
		humanoid.WalkSpeed = BoostConfig.WalkSpeedValue
	end
	
	if BoostConfig.JumpPowerEnabled then
		humanoid.JumpPower = BoostConfig.JumpPowerValue
	end
end

local function StartBoostLoop()
	if BoostConnection then
		BoostConnection:Disconnect()
	end
	
	BoostConnection = RunService.RenderStepped:Connect(function()
		ApplyBoost()
	end)
end

local function StopBoostLoop()
	if BoostConnection then
		BoostConnection:Disconnect()
		BoostConnection = nil
	end
	
	local character = LocalPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = BoostOriginalWalkSpeed
			humanoid.JumpPower = BoostOriginalJumpPower
		end
	end
end

local function SaveOriginalValues()
	local character = LocalPlayer.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		BoostOriginalWalkSpeed = humanoid.WalkSpeed
		BoostOriginalJumpPower = humanoid.JumpPower
	end
end

SaveOriginalValues()

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	SaveOriginalValues()
	if BoostConfig.WalkSpeedEnabled or BoostConfig.JumpPowerEnabled then
		StartBoostLoop()
	end
end)

