-- ==========================
-- FREECAM TP (Déplacement par petites téléportations)
-- ==========================
local FreeCamTPConfig = {
	Enabled = false,
	MoveSpeed = 200,
	SprintMultiplier = 5,
	TeleportStep = 1,
	OriginalCameraType = nil,
	OriginalCameraCFrame = nil,
}

local FreeCamTPConnection = nil
local FreeCamTPKeysHeld = {
	W = false, A = false, S = false, D = false,
	Space = false, LeftShift = false, Q = false, E = false,
}

local function EnableFreeCamTP()
	FreeCamTPConfig.Enabled = true
	
	local camera = workspace.CurrentCamera
	if camera then
		FreeCamTPConfig.OriginalCameraType = camera.CameraType
		FreeCamTPConfig.OriginalCameraCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable
	end
	
	if FreeCamTPConnection then
		FreeCamTPConnection:Disconnect()
	end
	
	FreeCamTPConnection = RunService.RenderStepped:Connect(function(deltaTime)
		if not FreeCamTPConfig.Enabled then return end
		
		if not LocalPlayer.Character then return end
		
		local humanoidRootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not humanoidRootPart then return end
		
		local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		humanoidRootPart.Anchored = false
		
		local cam = workspace.CurrentCamera
		if not cam then return end
		
		local moveDirection = Vector3.new()
		if FreeCamTPKeysHeld.W then moveDirection += cam.CFrame.LookVector end
		if FreeCamTPKeysHeld.S then moveDirection -= cam.CFrame.LookVector end
		if FreeCamTPKeysHeld.A then moveDirection -= cam.CFrame.RightVector end
		if FreeCamTPKeysHeld.D then moveDirection += cam.CFrame.RightVector end
		if FreeCamTPKeysHeld.Space or FreeCamTPKeysHeld.E then moveDirection += Vector3.new(0, 1, 0) end
		if FreeCamTPKeysHeld.Q then moveDirection -= Vector3.new(0, 1, 0) end
		
		if moveDirection.Magnitude > 0 then
			moveDirection = moveDirection.Unit
		end
		
		local currentSpeed = FreeCamTPConfig.MoveSpeed
		if FreeCamTPKeysHeld.LeftShift then
			currentSpeed = currentSpeed * FreeCamTPConfig.SprintMultiplier
		end
		
		local teleportDistance = currentSpeed * deltaTime
		local steps = math.ceil(teleportDistance / FreeCamTPConfig.TeleportStep)
		local stepDistance = teleportDistance / steps
		
		for i = 1, steps do
			local newPosition = cam.CFrame.Position + (moveDirection * stepDistance)
			humanoid:MoveTo(newPosition)
			task.wait()
			humanoidRootPart.CFrame = CFrame.new(newPosition, cam.CFrame.LookVector)
			cam.CFrame = CFrame.new(newPosition, cam.CFrame.LookVector)
		end
	end)
end

local function DisableFreeCamTP()
	FreeCamTPConfig.Enabled = false
	
	if FreeCamTPConnection then
		FreeCamTPConnection:Disconnect()
		FreeCamTPConnection = nil
	end
	
	local character = LocalPlayer.Character
	if character then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			humanoidRootPart.Anchored = false
		end
	end
	
	local camera = workspace.CurrentCamera
	if camera then
		if FreeCamTPConfig.OriginalCameraType then
			camera.CameraType = FreeCamTPConfig.OriginalCameraType
		end
	end
	
	for key in pairs(FreeCamTPKeysHeld) do
		FreeCamTPKeysHeld[key] = false
	end
end

local KeyCodeMap = {
	[Enum.KeyCode.W] = "W", [Enum.KeyCode.A] = "A",
	[Enum.KeyCode.S] = "S", [Enum.KeyCode.D] = "D",
	[Enum.KeyCode.Space] = "Space", [Enum.KeyCode.LeftShift] = "LeftShift",
