	local Lighting = game:GetService("Lighting")

	local function ApplySkybox(name)
		local preset = SkyboxPresets[name]
		if preset == nil then
			return
		end

		local existingSky = Lighting:FindFirstChild("CustomSky_NamelessHub")
		if existingSky then existingSky:Destroy() end
		local existingAtmo = Lighting:FindFirstChild("CustomAtmosphere_NamelessHub")
		if existingAtmo then existingAtmo:Destroy() end

		Lighting.ClockTime = preset.ClockTime
		Lighting.Brightness = preset.Brightness
		Lighting.Ambient = preset.Ambient
		Lighting.OutdoorAmbient = preset.OutdoorAmbient
		Lighting.ColorShift_Top = preset.ColorShiftTop
		Lighting.ColorShift_Bottom = preset.ColorShiftBottom

		local sky = Instance.new("Sky")
		sky.Name = "CustomSky_NamelessHub"
		sky.CelestialBodiesShown = preset.CelestialBodiesShown
		sky.StarCount = preset.StarCount

		if preset.Skybox then
			local textureProps = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" }
			for _, face in ipairs(textureProps) do
				local id = preset.Skybox[face]
				if id then
					local ok, err = pcall(function()
						sky["Skybox" .. face] = id
					end)
					if not ok then
						warn(("[Skybox] Face %s indisponible pour '%s' (asset peut-être modéré) : %s"):format(face, name, err))
					end
				end
			end
			if preset.Skybox.Sun then
				pcall(function() sky.SunTextureId = preset.Skybox.Sun end)
			end
			if preset.Skybox.Moon then
				pcall(function() sky.MoonTextureId = preset.Skybox.Moon end)
			end
		end

		sky.Parent = Lighting

		if preset.Atmosphere then
			local atmo = Instance.new("Atmosphere")
			atmo.Name = "CustomAtmosphere_NamelessHub"
			atmo.Density = preset.Atmosphere.Density
			atmo.Offset = preset.Atmosphere.Offset
			atmo.Color = preset.Atmosphere.Color
			atmo.Decay = preset.Atmosphere.Decay
			atmo.Glare = preset.Atmosphere.Glare
			atmo.Haze = preset.Atmosphere.Haze
			atmo.Parent = Lighting
		end
	end

	local SkyboxNames = {}
	for name in pairs(SkyboxPresets) do
		table.insert(SkyboxNames, name)
	end
	table.sort(SkyboxNames)

	return {
		Presets = SkyboxPresets,
		Names = SkyboxNames,
