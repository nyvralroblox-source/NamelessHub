-- FREE CAM MODULE (Obsidian UI)
-- ==========================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FreeCamActive = false
local FreeCamConnection = nil
local OriginalCameraType = nil

local MoveSpeed = 50
local SprintMultiplier = 3
local Sensitivity = 0.2

local YawAngle = 0
local PitchAngle = 0

local KeysHeld = {
	W = false, A = false, S = false, D = false,
	Space = false, LeftShift = false, Q = false, E = false,
}

local function StartFreeCam()
	if FreeCamActive then return end
	FreeCamActive = true

	OriginalCameraType = Camera.CameraType
	Camera.CameraType = Enum.CameraType.Scriptable

	local lookVector = Camera.CFrame.LookVector
	YawAngle = math.atan2(-lookVector.X, -lookVector.Z)
	PitchAngle = math.asin(lookVector.Y)

	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

	FreeCamConnection = RunService.RenderStepped:Connect(function(deltaTime)
		local mouseDelta = UserInputService:GetMouseDelta()
		YawAngle = YawAngle - math.rad(mouseDelta.X * Sensitivity)
		PitchAngle = math.clamp(
			PitchAngle - math.rad(mouseDelta.Y * Sensitivity),
			math.rad(-89), math.rad(89)
		)

		local rotationCFrame = CFrame.Angles(0, YawAngle, 0) * CFrame.Angles(PitchAngle, 0, 0)

		local moveDirection = Vector3.new()
		if KeysHeld.W then moveDirection += Vector3.new(0, 0, -1) end
		if KeysHeld.S then moveDirection += Vector3.new(0, 0, 1) end
		if KeysHeld.A then moveDirection += Vector3.new(-1, 0, 0) end
		if KeysHeld.D then moveDirection += Vector3.new(1, 0, 0) end
		if KeysHeld.Space or KeysHeld.E then moveDirection += Vector3.new(0, 1, 0) end
		if KeysHeld.Q then moveDirection += Vector3.new(0, -1, 0) end

		if moveDirection.Magnitude > 0 then
			moveDirection = moveDirection.Unit
		end

		local currentSpeed = MoveSpeed
		if KeysHeld.LeftShift then
			currentSpeed *= SprintMultiplier
		end

		local worldMoveDirection = rotationCFrame:VectorToWorldSpace(moveDirection)
		local newPosition = Camera.CFrame.Position + (worldMoveDirection * currentSpeed * deltaTime)

		Camera.CFrame = CFrame.new(newPosition) * rotationCFrame
	end)
end

local function StopFreeCam()
	if not FreeCamActive then return end
	FreeCamActive = false

	if FreeCamConnection then
		FreeCamConnection:Disconnect()
		FreeCamConnection = nil
	end

	UserInputService.MouseBehavior = Enum.MouseBehavior.Default

	if OriginalCameraType then
		Camera.CameraType = OriginalCameraType
	end

	-- Garde le toggle du menu synchronisé même si StopFreeCam
	-- est appelé depuis un autre endroit (ex: respawn)
	if Toggles and Toggles.FreeCamEnabled and Toggles.FreeCamEnabled.Value then
		Toggles.FreeCamEnabled:SetValue(false)
	end
end

-- Coupe automatiquement la caméra libre au respawn
LocalPlayer.CharacterAdded:Connect(function()
	if FreeCamActive then
		StopFreeCam()
	end
end)

