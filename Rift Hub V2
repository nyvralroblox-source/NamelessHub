-- ==========================
-- Branchement des Managers (avec vérifications pour éviter
-- un échec silencieux si l'executor a un souci de système de fichiers)
-- ==========================
local HUB_FOLDER = "MonScriptHub"
local CONFIG_FOLDER = HUB_FOLDER .. "/config"

-- 1) On s'assure que les dossiers existent AVANT de brancher les Managers.
--    C'est la cause la plus fréquente d'un SaveManager qui "ne charge pas" :
--    le dossier parent n'existe pas encore quand SetFolder est appelé.
local fsOk, fsErr = pcall(function()
	if not isfolder(HUB_FOLDER) then
		makefolder(HUB_FOLDER)
	end
	if not isfolder(CONFIG_FOLDER) then
		makefolder(CONFIG_FOLDER)
	end
end)

if not fsOk then
	Library:Notify("Erreur dossiers config : " .. tostring(fsErr), 6)
	warn("[SaveManager] Impossible de créer les dossiers : " .. tostring(fsErr))
	warn("[SaveManager] Ton executor ne supporte peut-être pas isfolder/makefolder/writefile.")
end

-- 2) Branchement des Managers sur la Library
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

-- 3) On ignore les paramètres de thème pour ne pas les sauvegarder dans les configs
SaveManager:IgnoreThemeSettings()

-- 4) On ignore la touche du menu (elle ne doit pas changer selon la config)
SaveManager:SetIgnoreIndexes({ "MenuKeybind" })

-- 5) Dossiers de sauvegarde
ThemeManager:SetFolder(HUB_FOLDER)
SaveManager:SetFolder(CONFIG_FOLDER)

-- 6) Construit la section config (liste, sauvegarde, chargement, autoload)
--    IMPORTANT : ceci doit arriver APRÈS que tous les AddToggle/AddSlider/
--    AddDropdown/AddColorPicker du script (Main, Visual, Player...) aient
--    été créés, sinon ces options ne seront pas incluses dans les configs.
--    C'est déjà le cas ici car ce bloc est tout en bas du script.
local buildOk, buildErr = pcall(function()
	SaveManager:BuildConfigSection(Tabs.Config)
	ThemeManager:ApplyToTab(Tabs.Config)
end)

if not buildOk then
	Library:Notify("Erreur construction Config : " .. tostring(buildErr), 6)
	warn("[SaveManager] BuildConfigSection/ApplyToTab a échoué : " .. tostring(buildErr))
end

-- 7) Charge automatiquement la config marquée "autoload" si elle existe
local loadOk, loadErr = pcall(function()
	SaveManager:LoadAutoloadConfig()
end)

if not loadOk then
	Library:Notify("Erreur autoload config : " .. tostring(loadErr), 6)
	warn("[SaveManager] LoadAutoloadConfig a échoué : " .. tostring(loadErr))
end









