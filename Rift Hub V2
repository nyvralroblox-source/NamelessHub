-- ==========================
-- EMOTE "TORNADE" (boucle tant que le toggle est actif)
-- ==========================
local TornadeAnimId = "rbxassetid://135083431918533"
local TornadeAnimTrack = nil
local TornadeActive = false

local function StopTornadeEmote()
	if TornadeAnimTrack then
		TornadeAnimTrack:Stop()
		TornadeAnimTrack:Destroy()
		TornadeAnimTrack = nil
	end
end

local function PlayTornadeEmote()
	StopTornadeEmote()

	local character = LocalPlayer.Character
	if not character then
		error("Aucun personnage trouvé (LocalPlayer.Character est nil)")
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		error("Aucun Humanoid trouvé dans le personnage")
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = TornadeAnimId

	local track = animator:LoadAnimation(animation)
	if not track then
		error("LoadAnimation n'a renvoyé aucune track (animation peut-être invalide/non autorisée)")
	end

	-- Priorité max pour ne pas être écrasée par l'idle/marche par défaut
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = true
	track:Play()
	TornadeAnimTrack = track
end

PlayerGroupBox:AddToggle("TornadeEmoteEnabled", {
	Text = "Tornade (emote en boucle)",
	Default = false,
	Callback = function(Value)
		TornadeActive = Value
		if Value then
			local ok, err = pcall(PlayTornadeEmote)
			if not ok then
				warn("[Tornade] Échec lancement : " .. tostring(err))
				Library:Notify("Tornade : échec - " .. tostring(err), 5)
			end
		else
			StopTornadeEmote()
		end
	end,
})

-- Relance l'emote automatiquement si le personnage respawn pendant que
