-- Clic gauche maintenu : un tracer part à chaque intervalle tant que le
-- bouton reste enfoncé, pas seulement au moment du clic.
local Mouse1Held = false
local TracerHoldLoopRunning = false

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if gameProcessedEvent then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

	Mouse1Held = true

	if Toggles.BulletTracerEnabled and Toggles.BulletTracerEnabled.Value then
		local ok, err = pcall(FireTracer)
		if not ok then
			warn("[Bullet Tracer] Échec : " .. tostring(err))
		end
	end

	if not TracerHoldLoopRunning then
		TracerHoldLoopRunning = true
		task.spawn(function()
			while Mouse1Held do
				local interval = (Options.TracerHoldInterval and Options.TracerHoldInterval.Value) or 0.1
				task.wait(interval)

				if Mouse1Held and Toggles.BulletTracerEnabled and Toggles.BulletTracerEnabled.Value then
					local ok2, err2 = pcall(FireTracer)
					if not ok2 then
						warn("[Bullet Tracer] Échec (maintien) : " .. tostring(err2))
					end
				end
			end
			TracerHoldLoopRunning = false
		end)
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessedEvent)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	Mouse1Held = false
end)

