-- ==========================
-- VOIDSPAM
-- ==========================
-- Comportement caractérisé par une alternance très rapide entre des apparitions
-- au contact d'un adversaire et des déplacements vers le vide situé sous la carte.
-- Cycle : Cible → Approche → Engagement → Retrait vers le vide → Retour → Répétition

local VoidSpamGroupBox = Tabs.Rage:AddRightGroupbox("VoidSpam", "crosshair")

local GroundSpamGroupBox = Tabs.Rage:AddRightGroupbox("Ground Spam", "crosshair")

local VoidSpamEnabled = false
local VoidSpamConnection = nil
local VoidSpamConfig = {
	ApproachDistance = 8,
	EngagementTime = 0.1,
	VoidWaitTime = 12,
	TargetPart = "HumanoidRootPart",
	VoidTeleportRate = 120,
	VoidTeleportRange = 25000,
	TeamCheck = true,
	MinHealth = 1,
	WalkSpeed = 500000,
	ServerSyncDelay = 0.008,
	ForceSync = true,
	OriginalCameraType = nil,
	OriginalCameraCFrame = nil,
}

local VoidSpamCurrentPhase = "idle" -- idle, target, approach, engage, void_wait, return
local VoidSpamTarget = nil
local VoidSpamTimer = 0
local VoidSpamLastPosition = nil
local VoidSpamLastTeleportTime = 0
local VoidSpamCycleCount = 0
local VoidSpamClickSimulated = nil
local VoidSpamOriginalWalkSpeed = nil

-- Indicateur d'état en bas de l'écran
local VoidSpamStatusText = Drawing.new("Text")
VoidSpamStatusText.Visible = false
VoidSpamStatusText.Text = "VoidSpam: Inactif"
VoidSpamStatusText.Size = 30
VoidSpamStatusText.Color = Color3.fromRGB(255, 255, 255)
VoidSpamStatusText.Outline = true
VoidSpamStatusText.OutlineColor = Color3.fromRGB(0, 0, 0)
VoidSpamStatusText.Center = true
VoidSpamStatusText.Position = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y - 30)

-- Mettre à jour la position quand la taille de l'écran change
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	VoidSpamStatusText.Position = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y - 30)
end)

-- Fonction pour forcer la synchronisation serveur
local function ForceServerSync(character, targetPosition)
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	-- Technique Shotgun Rage : CFrame.new(position, lookAt)
	if VoidSpamConfig.ForceSync then
		if targetPosition then
			humanoidRootPart.CFrame = CFrame.new(targetPosition, targetPosition + Vector3.new(0, 10, 0))
		end
		
		-- Reset basique des vélocités
		humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end

local function GetVoidSpamTarget()
	local target = nil
	local closestDistance = 100000
	local character = LocalPlayer.Character
	
	if not character then return nil end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return nil end
	
	for _, player in pairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		
		local targetCharacter = player.Character
		if not targetCharacter then continue end
		
		local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end
		
		-- Life check : vérifier que la cible a assez de santé
		if humanoid.Health < VoidSpamConfig.MinHealth then continue end
		
		-- Team check : vérifier que la cible n'est pas dans la même équipe
		if VoidSpamConfig.TeamCheck then
			if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
				continue
			end
		end
		
		local targetPart = targetCharacter:FindFirstChild(VoidSpamConfig.TargetPart)
		if not targetPart then
			targetPart = targetCharacter:FindFirstChild("HumanoidRootPart")
		end
		if not targetPart then continue end
		
		local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
		
		if distance < closestDistance then
			closestDistance = distance
			target = targetPart
		end
	end
	
	return target
end

local function VoidSpamCycle()
	if not VoidSpamEnabled then return end
	
	if not LocalPlayer.Character then return end
	
	local humanoidRootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	local currentTime = tick()
	
	local phaseText = ""
	if VoidSpamCurrentPhase == "idle" then
		phaseText = "Recherche cible..."
	elseif VoidSpamCurrentPhase == "approach" then
		phaseText = "Approche"
	elseif VoidSpamCurrentPhase == "engage" then
		phaseText = "Engagement"
	elseif VoidSpamCurrentPhase == "void_wait" then
		local timeRemaining = math.ceil(VoidSpamConfig.VoidWaitTime - (currentTime - VoidSpamTimer))
		phaseText = "Void (" .. timeRemaining .. "s)"
	elseif VoidSpamCurrentPhase == "return" then
		phaseText = "Retour"
	end
	
	VoidSpamStatusText.Text = "VoidSpam: " .. phaseText .. " | Cycles: " .. VoidSpamCycleCount
	
	if VoidSpamCurrentPhase == "idle" then
		VoidSpamTarget = GetVoidSpamTarget()
		VoidSpamClickSimulated = nil
		
		if VoidSpamTarget then
			VoidSpamCurrentPhase = "approach"
			VoidSpamTimer = currentTime
			VoidSpamCycleCount = 0
		end
	
	elseif VoidSpamCurrentPhase == "approach" then
		if VoidSpamTarget and VoidSpamTarget.Parent then
			local targetPosition = VoidSpamTarget.Position
			local approachPosition = targetPosition + Vector3.new(
				math.random(-VoidSpamConfig.ApproachDistance, VoidSpamConfig.ApproachDistance),
				10,
				math.random(-VoidSpamConfig.ApproachDistance, VoidSpamConfig.ApproachDistance)
			)
			
			humanoid:MoveTo(approachPosition)
			task.wait()
			humanoidRootPart.CFrame = CFrame.new(approachPosition, targetPosition)
			
			VoidSpamCurrentPhase = "engage"
			VoidSpamTimer = currentTime
			VoidSpamClickSimulated = nil
		else
			VoidSpamCurrentPhase = "idle"
			VoidSpamClickSimulated = nil
		end
	
	elseif VoidSpamCurrentPhase == "engage" then
		if VoidSpamTarget and VoidSpamTarget.Parent then
			local targetPosition = VoidSpamTarget.Position
			local engagePosition = targetPosition + Vector3.new(
				math.random(-VoidSpamConfig.ApproachDistance, VoidSpamConfig.ApproachDistance),
				10,
				math.random(-VoidSpamConfig.ApproachDistance, VoidSpamConfig.ApproachDistance)
			)
			
			humanoid:MoveTo(engagePosition)
			task.wait()
			humanoidRootPart.CFrame = CFrame.new(engagePosition, targetPosition)
		end
		
		if VoidSpamClickSimulated == nil then
			if mouse1click then
				mouse1click()
			end
			VoidSpamClickSimulated = true
		end
		
		if currentTime - VoidSpamTimer >= VoidSpamConfig.EngagementTime then
			VoidSpamLastPosition = humanoidRootPart.Position
			VoidSpamCurrentPhase = "void_wait"
			VoidSpamTimer = currentTime
			VoidSpamLastTeleportTime = currentTime
			VoidSpamClickSimulated = nil
		end
	
	-- Phase 4: Attente dans le void (12 secondes avec téléportations ultra-rapides)
	elseif VoidSpamCurrentPhase == "void_wait" then
		local timeInVoid = currentTime - VoidSpamTimer
		local teleportInterval = 1 / VoidSpamConfig.VoidTeleportRate
		
		if currentTime - VoidSpamLastTeleportTime >= teleportInterval then
			if VoidSpamTarget and VoidSpamTarget.Parent then
				local targetPos = VoidSpamTarget.Position
				local voidPosition = Vector3.new(
					targetPos.X + math.random(-VoidSpamConfig.VoidTeleportRange, VoidSpamConfig.VoidTeleportRange),
					targetPos.Y + 10,
					targetPos.Z + math.random(-VoidSpamConfig.VoidTeleportRange, VoidSpamConfig.VoidTeleportRange)
				)
				
				humanoid:MoveTo(voidPosition)
				task.wait()
				humanoidRootPart.CFrame = CFrame.new(voidPosition, voidPosition + Vector3.new(0, 10, 0))
				
				VoidSpamLastTeleportTime = currentTime
			end
		end
		
		if timeInVoid >= VoidSpamConfig.VoidWaitTime then
			VoidSpamCurrentPhase = "return"
			VoidSpamTimer = currentTime
		end
	
	elseif VoidSpamCurrentPhase == "return" then
		if VoidSpamTarget and VoidSpamTarget.Parent then
			local targetPosition = VoidSpamTarget.Position
			local returnPosition = targetPosition + Vector3.new(
				math.random(-VoidSpamConfig.ApproachDistance, VoidSpamConfig.ApproachDistance),
				10,
				math.random(-VoidSpamConfig.ApproachDistance, VoidSpamConfig.ApproachDistance)
			)
			
			humanoid:MoveTo(returnPosition)
			task.wait()
			humanoidRootPart.CFrame = CFrame.new(returnPosition, targetPosition)
			
			VoidSpamCycleCount = VoidSpamCycleCount + 1
			
			VoidSpamCurrentPhase = "engage"
			VoidSpamTimer = currentTime
		else
			VoidSpamCurrentPhase = "idle"
		end
	end
end

local function EnableVoidSpam()
	VoidSpamEnabled = true
	VoidSpamCurrentPhase = "idle"
	VoidSpamTarget = nil
	VoidSpamCycleCount = 0
	
	-- Afficher l'indicateur
	VoidSpamStatusText.Visible = true
	
	-- Sauvegarder et appliquer la vitesse de déplacement
	local character = LocalPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			VoidSpamOriginalWalkSpeed = humanoid.WalkSpeed
			humanoid.WalkSpeed = VoidSpamConfig.WalkSpeed
		end
		
		-- Désancrer le HumanoidRootPart pour permettre le mouvement
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			humanoidRootPart.Anchored = false
		end
	end
	
	-- Sauvegarder et désynchroniser la caméra
	local camera = workspace.CurrentCamera
	if camera then
		VoidSpamConfig.OriginalCameraType = camera.CameraType
		VoidSpamConfig.OriginalCameraCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable -- Mode scriptable pour contrôle total
	end
	
	if VoidSpamConnection then
		VoidSpamConnection:Disconnect()
	end
	
	VoidSpamConnection = RunService.RenderStepped:Connect(function()
		-- Mettre à jour la position de l'indicateur
		local camera = workspace.CurrentCamera
		if camera then
			VoidSpamStatusText.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y - 30)
		end
		
		-- Garder la caméra fixe à sa position originale
		if camera and VoidSpamConfig.OriginalCameraCFrame then
			camera.CFrame = VoidSpamConfig.OriginalCameraCFrame
		end
		
		local ok, err = pcall(VoidSpamCycle)
		if not ok then
			warn("[VoidSpam] Erreur: " .. tostring(err))
		end
	end)
end

local function DisableVoidSpam()
	VoidSpamEnabled = false
	VoidSpamCurrentPhase = "idle"
	VoidSpamTarget = nil
	VoidSpamCycleCount = 0
	
	-- Cacher l'indicateur
	VoidSpamStatusText.Visible = false
	VoidSpamStatusText.Text = "VoidSpam: Inactif"
	
	-- Restaurer la vitesse de déplacement originale
	local character = LocalPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and VoidSpamOriginalWalkSpeed then
			humanoid.WalkSpeed = VoidSpamOriginalWalkSpeed
		end
		
		-- Désancrer le HumanoidRootPart pour permettre le mouvement normal
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			humanoidRootPart.Anchored = false
		end
	end
	
	-- Restaurer la caméra
	local camera = workspace.CurrentCamera
	if camera then
		if VoidSpamConfig.OriginalCameraType then
			camera.CameraType = VoidSpamConfig.OriginalCameraType
		end
	end
	
	if VoidSpamConnection then
		VoidSpamConnection:Disconnect()
		VoidSpamConnection = nil
	end
end

