-- FOV DÉCORATIF (multi-formes, 100% visuel, ne sert à rien niveau gameplay)
-- ==========================
-- Anneau polygonal centré sur l'écran, avec un dégradé noir/blanc qui
-- tourne le long des bords. Purement esthétique : centré sur l'écran (pas
-- sur la souris/une cible), donc aucun lien avec la visée.
local FOVGroupBox = Tabs.Visual:AddRightGroupbox("FOV décoratif", "octagon")

local FOVShapes = {
	["Triangle"] = { Points = 3, InnerRatio = 1, AngleOffset = -math.pi / 2 },
	["Carré"] = { Points = 4, InnerRatio = 1, AngleOffset = math.pi / 4 },
	["Losange"] = { Points = 4, InnerRatio = 1, AngleOffset = 0 },
	["Pentagone"] = { Points = 5, InnerRatio = 1, AngleOffset = -math.pi / 2 },
	["Hexagone"] = { Points = 6, InnerRatio = 1, AngleOffset = 0 },
	["Heptagone"] = { Points = 7, InnerRatio = 1, AngleOffset = -math.pi / 2 },
	["Octogone"] = { Points = 8, InnerRatio = 1, AngleOffset = math.pi / 8 },
	["Décagone"] = { Points = 10, InnerRatio = 1, AngleOffset = 0 },
	["Étoile 5 branches"] = { Points = 5, InnerRatio = 0.45, AngleOffset = -math.pi / 2 },
	["Étoile 6 branches"] = { Points = 6, InnerRatio = 0.5, AngleOffset = -math.pi / 2 },
	["Cercle (32 côtés)"] = { Points = 32, InnerRatio = 1, AngleOffset = 0 },
}

local FOVShapeNames = {}
for name in pairs(FOVShapes) do
	table.insert(FOVShapeNames, name)
end
table.sort(FOVShapeNames)

local FOVLines = {}
local FOVLineCount = 0

local function EnsureFOVLineCount(count)
	if FOVLineCount == count then return end

	for i = #FOVLines, count + 1, -1 do
		if FOVLines[i] then
			FOVLines[i]:Remove()
			FOVLines[i] = nil
		end
	end

	for i = 1, count do
		if not FOVLines[i] then
			local line = Drawing.new("Line")
			line.Thickness = 2
			line.Visible = false
			FOVLines[i] = line
		end
	end

	FOVLineCount = count
end

local function BuildPolygonVertices(centerX, centerY, radius, shape)
	local vertexCount = shape.InnerRatio < 1 and shape.Points * 2 or shape.Points
	local vertices = {}

	for i = 1, vertexCount do
		local angle = (i - 1) * (2 * math.pi / vertexCount) + shape.AngleOffset
		local r = radius
		if shape.InnerRatio < 1 and (i % 2 == 0) then
			r = radius * shape.InnerRatio
		end
		vertices[i] = Vector2.new(centerX + r * math.cos(angle), centerY + r * math.sin(angle))
	end

	return vertices
end

local FOVPhase = 0

local function UpdateFOVOctagon(dt)
	if not (Toggles.FOVDecoEnabled and Toggles.FOVDecoEnabled.Value) then
		for i = 1, #FOVLines do
			FOVLines[i].Visible = false
		end
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	local centerX, centerY = viewport.X / 2, viewport.Y / 2
	local radius = (Options.FOVDecoSize and Options.FOVDecoSize.Value) or 150
	local speed = (Options.FOVDecoSpeed and Options.FOVDecoSpeed.Value) or 2
	local shapeName = (Options.FOVDecoShape and Options.FOVDecoShape.Value) or "Octogone"
	local shape = FOVShapes[shapeName] or FOVShapes["Octogone"]

	FOVPhase = FOVPhase + dt * speed

	local vertices = BuildPolygonVertices(centerX, centerY, radius, shape)
	local n = #vertices
	EnsureFOVLineCount(n)

	for i = 1, n do
		local line = FOVLines[i]
		line.From = vertices[i]
		line.To = vertices[(i % n) + 1]

		-- Dégradé noir/blanc qui se déplace le long des côtés
		local t = (i - 1) / n
		local brightness = (math.sin((t * 2 * math.pi) + FOVPhase) + 1) / 2
		line.Color = Color3.new(brightness, brightness, brightness)
		line.Visible = true
	end
end

