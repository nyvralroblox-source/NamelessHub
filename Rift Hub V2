local CrosshairGroupBox = Tabs.Visual:AddRightGroupbox("Crosshair custom", "crosshair")

local CrosshairShapes = {
	["Losange"] = { AngleOffset = 0 },
	["Carré"] = { AngleOffset = math.pi / 4 },
}

local CrosshairLines = {}
for i = 1, 4 do
	local line = Drawing.new("Line")
	line.Thickness = 2
	line.Visible = false
	CrosshairLines[i] = line
end

local CrosshairPhase = 0

local function UpdateCrosshair(dt)
	if not (Toggles.CrosshairEnabled and Toggles.CrosshairEnabled.Value) then
		for i = 1, 4 do
			CrosshairLines[i].Visible = false
		end
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	local centerX, centerY = viewport.X / 2, viewport.Y / 2

	local shapeName = (Options.CrosshairShape and Options.CrosshairShape.Value) or "Losange"
	local shape = CrosshairShapes[shapeName] or CrosshairShapes["Losange"]
	local radius = (Options.CrosshairSize and Options.CrosshairSize.Value) or 20
	local speed = (Options.CrosshairSpeed and Options.CrosshairSpeed.Value) or 3

	CrosshairPhase = CrosshairPhase + dt * speed

	local vertices = {}
	for i = 1, 4 do
		local angle = (i - 1) * (2 * math.pi / 4) + shape.AngleOffset
		vertices[i] = Vector2.new(
			centerX + radius * math.cos(angle),
			centerY + radius * math.sin(angle)
		)
	end

	for i = 1, 4 do
		local line = CrosshairLines[i]
		line.From = vertices[i]
		line.To = vertices[(i % 4) + 1]

		local t = (i - 1) / 4
		local brightness = (math.sin((t * 2 * math.pi) + CrosshairPhase) + 1) / 2
		line.Color = Color3.new(brightness, brightness, brightness)
		line.Visible = true
	end
end

