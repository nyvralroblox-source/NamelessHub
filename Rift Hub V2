-- Crosshair (à coller après la création des Tabs)
-- ==========================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local CrosshairSettings = {
	Enabled = false,
	Size = 12,
	Thickness = 2,
	Gap = 4,
	Color = Color3.fromRGB(255, 255, 255),
	OutlineColor = Color3.fromRGB(0, 0, 0),
	OutlineSize = 1,
	RotationSpeed = 90,
	Pattern = "Spin", -- "None" | "Spin" | "Pulse" | "Rainbow" | "Breathe" | "SpinPulse"
}

local CrosshairGui = Instance.new("ScreenGui")
CrosshairGui.Name = "CustomCrosshair"
CrosshairGui.ResetOnSpawn = false
CrosshairGui.IgnoreGuiInset = true
CrosshairGui.Enabled = false
CrosshairGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local CrosshairRoot = Instance.new("Frame")
CrosshairRoot.AnchorPoint = Vector2.new(0.5, 0.5)
CrosshairRoot.Position = UDim2.fromScale(0.5, 0.5)
CrosshairRoot.Size = UDim2.fromOffset(0, 0)
CrosshairRoot.BackgroundTransparency = 1
CrosshairRoot.Parent = CrosshairGui

local function createBranch(name)
	local b = Instance.new("Frame")
	b.Name = name
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.BackgroundColor3 = CrosshairSettings.Color
	b.BorderSizePixel = 0
	b.Parent = CrosshairRoot
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Thickness = CrosshairSettings.OutlineSize
	stroke.Color = CrosshairSettings.OutlineColor
	stroke.Parent = b
	return b
end

local CrosshairBranches = {
	Top = createBranch("Top"), Bottom = createBranch("Bottom"),
	Left = createBranch("Left"), Right = createBranch("Right"),
}

local function refreshCrosshairGeometry()
	local s, t, g = CrosshairSettings.Size, CrosshairSettings.Thickness, CrosshairSettings.Gap
	CrosshairBranches.Top.Size = UDim2.fromOffset(t, s)
	CrosshairBranches.Top.Position = UDim2.fromOffset(0, -(g + s / 2))
	CrosshairBranches.Bottom.Size = UDim2.fromOffset(t, s)
	CrosshairBranches.Bottom.Position = UDim2.fromOffset(0, g + s / 2)
	CrosshairBranches.Left.Size = UDim2.fromOffset(s, t)
	CrosshairBranches.Left.Position = UDim2.fromOffset(-(g + s / 2), 0)
	CrosshairBranches.Right.Size = UDim2.fromOffset(s, t)
	CrosshairBranches.Right.Position = UDim2.fromOffset(g + s / 2, 0)
end

local function refreshCrosshairColors()
	for _, b in pairs(CrosshairBranches) do
		b.BackgroundColor3 = CrosshairSettings.Color
		b.Outline.Color = CrosshairSettings.OutlineColor
		b.Outline.Thickness = CrosshairSettings.OutlineSize
	end
end

refreshCrosshairGeometry()
refreshCrosshairColors()

local ch_rotation, ch_elapsed, ch_hue = 0, 0, 0
RunService.RenderStepped:Connect(function(dt)
	if not CrosshairSettings.Enabled then return end
	ch_elapsed += dt

	if CrosshairSettings.Pattern == "Spin" or CrosshairSettings.Pattern == "SpinPulse" then
		ch_rotation = (ch_rotation + CrosshairSettings.RotationSpeed * dt) % 360
		CrosshairRoot.Rotation = ch_rotation
	end

	if CrosshairSettings.Pattern == "Pulse" or CrosshairSettings.Pattern == "SpinPulse" then
		local scale = 1 + math.sin(ch_elapsed * 4) * 0.25
		for name, b in pairs(CrosshairBranches) do
			local base = (name == "Top" or name == "Bottom")
				and Vector2.new(CrosshairSettings.Thickness, CrosshairSettings.Size)
				or Vector2.new(CrosshairSettings.Size, CrosshairSettings.Thickness)
			b.Size = UDim2.fromOffset(base.X * scale, base.Y * scale)
		end
	end

	if CrosshairSettings.Pattern == "Breathe" then
		local alpha = 0.5 + math.sin(ch_elapsed * 2) * 0.5
		for _, b in pairs(CrosshairBranches) do b.BackgroundTransparency = 1 - alpha end
	end

	if CrosshairSettings.Pattern == "Rainbow" then
		ch_hue = (ch_hue + dt * 0.3) % 1
		local color = Color3.fromHSV(ch_hue, 1, 1)
		for _, b in pairs(CrosshairBranches) do b.BackgroundColor3 = color end
	end
end)

