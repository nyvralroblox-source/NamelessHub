-- SILENT AIM
-- ==========================
local SilentAimCamera = workspace.CurrentCamera

local SilentAimConfig = {
	Enabled = false,
	FOV = 200,
	Smoothness = 1.5,
	TargetPart = "Head",
	TeamCheck = true,
	MinHealth = 1,
	ShowFOV = true,
}

local SilentAimConnection = nil
local SilentAimTarget = nil
local SilentAimCircle = Drawing.new("Circle")
SilentAimCircle.Thickness = 1
SilentAimCircle.Visible = false
SilentAimCircle.Color = Color3.fromRGB(255, 50, 50)
SilentAimCircle.Transparency = 0.5
SilentAimCircle.Filled = false

local function GetSilentAimTarget()
	local target = nil
	local closestDistance = SilentAimConfig.FOV
	local mousePos = SilentAimUserInputService:GetMouseLocation()
	
	for _, player in pairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		
		local targetCharacter = player.Character
		if not targetCharacter then continue end
		
		local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end
		
		-- Health check
		if humanoid.Health < SilentAimConfig.MinHealth then continue end
		
		-- Team check
		if SilentAimConfig.TeamCheck then
			if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
				continue
			end
		end
		
		-- Chercher la partie ciblée (HeadHB si disponible, sinon Head, puis HumanoidRootPart)
		local targetPart = targetCharacter:FindFirstChild("HeadHB") or 
		                  targetCharacter:FindFirstChild(SilentAimConfig.TargetPart) or 
		                  targetCharacter:FindFirstChild("Head") or 
		                  targetCharacter:FindFirstChild("HumanoidRootPart")
		
		if not targetPart then continue end
		
		local pos, onScreen = SilentAimCamera:WorldToViewportPoint(targetPart.Position)
		if not onScreen then continue end
		
		local distance = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
		
		if distance < closestDistance then
			closestDistance = distance
			target = targetPart
		end
	end
	
	return target
end

local function UpdateSilentAimFOV()
	if SilentAimConfig.ShowFOV then
		SilentAimCircle.Visible = SilentAimConfig.Enabled
		SilentAimCircle.Radius = SilentAimConfig.FOV
		SilentAimCircle.Position = UserInputService:GetMouseLocation()
	else
		SilentAimCircle.Visible = false
	end
end

local function SilentAimCycle()
	if not SilentAimConfig.Enabled then return end
	
	SilentAimTarget = GetSilentAimTarget()
	UpdateSilentAimFOV()
end

local function EnableSilentAim()
	SilentAimConfig.Enabled = true
	
	if SilentAimConnection then
		SilentAimConnection:Disconnect()
	end
	
	SilentAimConnection = RunService.RenderStepped:Connect(function()
		local ok, err = pcall(SilentAimCycle)
		if not ok then
			warn("[SilentAim] Erreur: " .. tostring(err))
		end
	end)
	
	HookSilentAim()
end

local function DisableSilentAim()
	SilentAimConfig.Enabled = false
	SilentAimTarget = nil
	SilentAimCircle.Visible = false
	
	if SilentAimConnection then
		SilentAimConnection:Disconnect()
		SilentAimConnection = nil
	end
end

-- Hook pour la redirection des tirs (silent aim)
local SilentAimMouseMoveConnection = nil

local function HookSilentAim()
	if SilentAimMouseMoveConnection then return end
	
	-- Utiliser mousemoverel pour rediriger silencieusement les tirs
	SilentAimMouseMoveConnection = SilentAimRunService.RenderStepped:Connect(function()
		if SilentAimConfig.Enabled and SilentAimTarget then
			local pos, _ = SilentAimCamera:WorldToViewportPoint(SilentAimTarget.Position)
			local mousePos = SilentAimUserInputService:GetMouseLocation()
			
			-- Calculer le mouvement relatif
			local x = (pos.X - mousePos.X) * SilentAimConfig.Smoothness
			local y = (pos.Y - mousePos.Y) * SilentAimConfig.Smoothness
			
			-- Rediriger la souris silencieusement
			if mousemoverel then
				mousemoverel(x, y)
			end
		end
	end)
end

local function UnhookSilentAim()
	if SilentAimMouseMoveConnection then
		SilentAimMouseMoveConnection:Disconnect()
		SilentAimMouseMoveConnection = nil
	end
end

