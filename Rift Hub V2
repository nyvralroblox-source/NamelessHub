-- ==========================
-- TINY MESH MODE (wireframe/outline effect)
-- ==========================
-- Rend les modèles 3D invisibles sauf leurs contours extérieurs
local TinyMeshGroupBox = Tabs.Visual:AddRightGroupbox("Tiny Mesh Mode", "mesh")

local TinyMeshModelIDs = {
	12613284249, 12613283569, 12613284036, 14652718299, 12613283355, 12613284529, 12613284768
}

local TinyMeshOriginalParts = {} -- Stocke les propriétés originales des parties
local TinyMeshSelectionBoxes = {} -- Stocke les SelectionBox créés
local TinyMeshConnection = nil

local function ResetTinyMesh()
	-- Nettoyer les SelectionBox
	for _, selectionBox in pairs(TinyMeshSelectionBoxes) do
		if selectionBox then
			selectionBox:Destroy()
		end
	end
	TinyMeshSelectionBoxes = {}
	
	-- Restaurer les propriétés originales des parties
	for part, originalData in pairs(TinyMeshOriginalParts) do
		if part and part.Parent then
			part.Transparency = originalData.Transparency
			part.Material = originalData.Material
			part.Color = originalData.Color
			part.Reflectance = originalData.Reflectance
		end
	end
	TinyMeshOriginalParts = {}
	
	-- Déconnecter le rendu si actif
	if TinyMeshConnection then
		TinyMeshConnection:Disconnect()
		TinyMeshConnection = nil
	end
end

local function ApplyTinyMesh()
	ResetTinyMesh()
	
	-- Chercher les modèles avec les IDs spécifiés
	for _, modelID in pairs(TinyMeshModelIDs) do
		-- Chercher dans tout le workspace
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj:IsA("Model") and obj.Name == tostring(modelID) then
				-- Appliquer l'effet wireframe à toutes les parties du modèle
				for _, part in pairs(obj:GetDescendants()) do
					if part:IsA("BasePart") then
						-- Sauvegarder les propriétés originales
						TinyMeshOriginalParts[part] = {
							Transparency = part.Transparency,
							Material = part.Material,
							Color = part.Color,
							Reflectance = part.Reflectance
						}
						
						-- Rendre la partie transparente
						part.Transparency = 1
						part.Material = Enum.Material.SmoothPlastic
						part.Reflectance = 0
						
						-- Créer un SelectionBox pour le contour
						local selectionBox = Instance.new("SelectionBox")
						selectionBox.Name = "TinyMeshOutline_NamelessHub"
						selectionBox.Adornee = part
						selectionBox.Color3 = Color3.fromRGB(255, 255, 255)
						selectionBox.LineThickness = 0.05
						selectionBox.Transparency = 0.5
						selectionBox.Parent = part
						table.insert(TinyMeshSelectionBoxes, selectionBox)
					end
				end
			end
		end
	end
	
	-- Maintenir l'effet en continu (au cas où le jeu recharge les modèles)
	TinyMeshConnection = RunService.RenderStepped:Connect(function()
		if not (Toggles.TinyMeshEnabled and Toggles.TinyMeshEnabled.Value) then
			ResetTinyMesh()
			return
		end
		
		-- Vérifier et réappliquer si nécessaire
		for _, modelID in pairs(TinyMeshModelIDs) do
			for _, obj in pairs(workspace:GetDescendants()) do
				if obj:IsA("Model") and obj.Name == tostring(modelID) then
					for _, part in pairs(obj:GetDescendants()) do
						if part:IsA("BasePart") and not TinyMeshOriginalParts[part] then
							-- Nouvelle partie détectée, appliquer l'effet
							TinyMeshOriginalParts[part] = {
								Transparency = part.Transparency,
								Material = part.Material,
								Color = part.Color,
								Reflectance = part.Reflectance
							}
							
							part.Transparency = 1
							part.Material = Enum.Material.SmoothPlastic
							part.Reflectance = 0
							
							local selectionBox = Instance.new("SelectionBox")
							selectionBox.Name = "TinyMeshOutline_NamelessHub"
							selectionBox.Adornee = part
							selectionBox.Color3 = Color3.fromRGB(255, 255, 255)
							selectionBox.LineThickness = 0.05
							selectionBox.Transparency = 0.5
							selectionBox.Parent = part
							table.insert(TinyMeshSelectionBoxes, selectionBox)
						elseif part:IsA("BasePart") and TinyMeshOriginalParts[part] then
							-- Maintenir l'effet
							part.Transparency = 1
							part.Material = Enum.Material.SmoothPlastic
							part.Reflectance = 0
						end
					end
				end
			end
		end
	end)
end

TinyMeshGroupBox:AddToggle("TinyMeshEnabled", {
	Text = "Activer Tiny Mesh Mode",
	Default = false,
	Callback = function(Value)
		if Value then
			local ok, err = pcall(ApplyTinyMesh)
			if not ok then
				warn("[Tiny Mesh] Échec activation : " .. tostring(err))
				Library:Notify("Tiny Mesh : échec - " .. tostring(err), 5)
			end
		else
			ResetTinyMesh()
		end
	end,
})

