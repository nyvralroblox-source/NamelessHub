-- Boucle unique, toujours connectée, qui n'agit que si le toggle est activé
-- ET que le clic gauche est maintenu
OrientHeartbeatConnection = RunService.Heartbeat:Connect(function()
    local camera = workspace.CurrentCamera
    local isActive = OrientFeatureEnabled and LeftMouseHeld

    if isActive and not WasActiveLastFrame then
        -- On vient d'activer : caméra en mode Scriptable
        SavedCameraType = camera.CameraType
        camera.CameraType = Enum.CameraType.Scriptable
    elseif not isActive and WasActiveLastFrame then
        -- On vient de désactiver (relâché le clic ou toggle off) :
        -- on restaure la caméra normale contrôlable à la souris
        if SavedCameraType then
            camera.CameraType = SavedCameraType
            SavedCameraType = nil
        else
            camera.CameraType = Enum.CameraType.Custom
        end
    end

    WasActiveLastFrame = isActive

    if not isActive then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local target = GetNearestPlayer()
    if not target then return end

    -- On ne touche plus au CFrame du personnage : seule la caméra est
    -- orientée. Ainsi tes touches (ZQSD/WASD) et le déplacement du
    -- personnage restent 100% normaux et ne sont jamais perturbés.
    local myHead = myChar:FindFirstChild("Head")
    local targetHead = GetTargetHead(target)
    local camPos = myHead and myHead.Position or (myRoot.Position + Vector3.new(0, 2, 0))
    local lookAtPos = targetHead and targetHead.Position or target.Position

    camera.CFrame = CFrame.lookAt(camPos, lookAtPos)
end)

