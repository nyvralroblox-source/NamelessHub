-- ==========================
-- GROUND SPAM
-- ==========================
local GroundSpamPlayers = game:GetService("Players")
local GroundSpamLocalPlayer = GroundSpamPlayers.LocalPlayer
local GroundSpamRunService = game:GetService("RunService")

local GroundSpamConfig = {
	Enabled = false,
	Depth = 2, -- Profondeur dans le sol
	StretchAmount = 2, -- Facteur d'allongement
	LookAtSky = true, -- Regarder vers le ciel
	PreventDeath = true, -- EmpÃªcher la mort
	ForceSync = true, -- Forcer la synchronisation serveur
	SyncDelay = 0.016, -- DÃ©lai pour synchronisation serveur
	OriginalPosition = nil, -- Sauvegarder la position originale
	TargetPosition = nil, -- Position cible dans le sol (fixe)
	Anchor = false, -- Plus d'ancrage pour permettre la rÃ©plication rÃ©seau
	TeleportDone = false, -- Indicateur si la tÃ©lÃ©portation est faite
	UseMoveTo = true, -- Utiliser Humanoid:MoveTo() pour la rÃ©plication serveur
}

local GroundSpamConnection = nil
local GroundSpamOriginalTransparency = {}
local GroundSpamOriginalSize = {}

local function EnableGroundSpam()
	GroundSpamConfig.Enabled = true
	GroundSpamConfig.TeleportDone = false
	
	local character = GroundSpamLocalPlayer.Character
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Sauvegarder la position originale avant de tÃ©lÃ©porter
	GroundSpamConfig.OriginalPosition = humanoidRootPart.Position
	
	-- Calculer la position cible dans le sol (une seule fois)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {character}
	
	local rayResult = workspace:Raycast(humanoidRootPart.Position, Vector3.new(0, -50, 0), rayParams)
	
	if rayResult then
		GroundSpamConfig.TargetPosition = rayResult.Position - Vector3.new(0, GroundSpamConfig.Depth, 0)
	else
		GroundSpamConfig.TargetPosition = GroundSpamConfig.OriginalPosition - Vector3.new(0, GroundSpamConfig.Depth, 0)
	end
	
	-- Sauvegarder les propriÃ©tÃ©s originales des parties du corps
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			GroundSpamOriginalTransparency[part] = part.Transparency
			GroundSpamOriginalSize[part] = part.Size
		end
	end
	
	if GroundSpamConnection then
		GroundSpamConnection:Disconnect()
	end
	
	-- Boucle continue pour rester stable dans le sol avec rÃ©plication serveur
	GroundSpamConnection = GroundSpamRunService.RenderStepped:Connect(function()
		if not GroundSpamConfig.Enabled then return end
		
		local character = GroundSpamLocalPlayer.Character
		if not character then return end
		
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if not humanoidRootPart then return end
		
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		-- Garder no clip actif en permanence
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
		
		-- NE PAS ancrer pour permettre la rplication rÃ©seau
		humanoidRootPart.Anchored = false
		
		-- TÃ©lÃ©porter une seule fois vers la position cible avec rÃ©plication serveur
		if not GroundSpamConfig.TeleportDone and GroundSpamConfig.TargetPosition then
			if GroundSpamConfig.UseMoveTo then
				-- Utiliser Humanoid:MoveTo() pour la rÃ©plication serveur
				humanoid:MoveTo(GroundSpamConfig.TargetPosition)
			else
				-- Utiliser CFrame direct (moins fiable pour la rÃ©plication)
				humanoidRootPart.CFrame = CFrame.new(GroundSpamConfig.TargetPosition)
			end
			GroundSpamConfig.TeleportDone = true
		end
		
		-- Continuer Ã  envoyer la position pour maintenir la rÃ©plication
		if GroundSpamConfig.TeleportDone and GroundSpamConfig.TargetPosition then
			if GroundSpamConfig.UseMoveTo then
				humanoid:MoveTo(GroundSpamConfig.TargetPosition)
			else
				humanoidRootPart.CFrame = CFrame.new(GroundSpamConfig.TargetPosition)
			end
		end
		
		-- Forcer la synchronisation serveur
		if GroundSpamConfig.ForceSync then
			humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
		
		-- Allonger le personnage
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local originalSize = GroundSpamOriginalSize[part]
				if originalSize then
					part.Size = Vector3.new(originalSize.X, originalSize.Y * GroundSpamConfig.StretchAmount, originalSize.Z)
				end
			end
		end
		
		-- Regarder vers le ciel
		if GroundSpamConfig.LookAtSky then
			humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position) * CFrame.Angles(math.rad(-90), 0, 0)
		end
		
		-- EmpÃªcher la mort
		if GroundSpamConfig.PreventDeath then
			humanoid.Health = math.max(humanoid.Health, 1)
		end
	end)
end

local function DisableGroundSpam()
	GroundSpamConfig.Enabled = false
	
	local character = GroundSpamLocalPlayer.Character
	if character then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		
		-- Remonter Ã  la position originale
		if humanoidRootPart and GroundSpamConfig.OriginalPosition then
			humanoidRootPart.CFrame = CFrame.new(GroundSpamConfig.OriginalPosition)
		end
		
		-- DÃ©sancrer le personnage
		if GroundSpamConfig.Anchor then
			if humanoidRootPart then
				humanoidRootPart.Anchored = false
			end
		end
		
		-- Restaurer les collisions immÃ©diatement
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
		
		-- Restaurer la taille originale
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				if GroundSpamOriginalSize[part] then
					part.Size = GroundSpamOriginalSize[part]
				end
				
				-- Restaurer la transparence originale
				if GroundSpamOriginalTransparency[part] then
					part.Transparency = GroundSpamOriginalTransparency[part]
				end
			end
		end
	end
	
	-- Nettoyer les tables
	GroundSpamOriginalTransparency = {}
	GroundSpamOriginalSize = {}
	GroundSpamConfig.OriginalPosition = nil
	GroundSpamConfig.TargetPosition = nil
	GroundSpamConfig.TeleportDone = false
	
	if GroundSpamConnection then
		GroundSpamConnection:Disconnect()
		GroundSpamConnection = nil
	end
end

