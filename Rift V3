local GroundRageConfig = {
    Enabled = false,
    Depth = 3, -- Profondeur dans le sol
    Anchor = true, -- Ancrer pour éviter les corrections physiques
    ForceSync = true, -- Forcer la synchronisation serveur
    SyncDelay = 0.016, -- Délai pour synchronisation serveur
    OriginalCFrame = nil, -- Sauvegarder le CFrame original
    OriginalAnchored = nil, -- Sauvegarder l'état anchored original
    Connection = nil,
}

local GroundRageStatusText = Drawing.new("Text")
GroundRageStatusText.Visible = false
GroundRageStatusText.Text = "Ground Rage: Inactif"
GroundRageStatusText.Size = 18
GroundRageStatusText.Color = Color3.fromRGB(255, 100, 0)
GroundRageStatusText.Outline = true
GroundRageStatusText.OutlineColor = Color3.fromRGB(0, 0, 0)
GroundRageStatusText.Center = false

local function EnableGroundRage()
    GroundRageConfig.Enabled = true
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    -- Sauvegarder l'état original
    GroundRageConfig.OriginalCFrame = humanoidRootPart.CFrame
    GroundRageConfig.OriginalAnchored = humanoidRootPart.Anchored
    
    -- Afficher l'indicateur
    GroundRageStatusText.Visible = true
    
    if GroundRageConfig.Connection then
        GroundRageConfig.Connection:Disconnect()
    end
    
    GroundRageConfig.Connection = RunService.Heartbeat:Connect(function()
        if not GroundRageConfig.Enabled then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        
        -- Désactiver les collisions pour éviter les interférences
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        -- Trouver la position du sol
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {character}
        
        local rayResult = workspace:Raycast(humanoidRootPart.Position, Vector3.new(0, -100, 0), rayParams)
        local groundY = humanoidRootPart.Position.Y
        
        if rayResult then
            groundY = rayResult.Position.Y
        end
        
        -- Position horizontale dans le sol (rotation de 90 degrés sur l'axe X)
        local horizontalPosition = Vector3.new(humanoidRootPart.Position.X, groundY - GroundRageConfig.Depth, humanoidRootPart.Position.Z)
        
        -- Orienter le personnage horizontalement (allongé parallèlement au sol)
        -- L'orientation reste constante, on ne modifie que la rotation pour être horizontal
        local currentRotation = humanoidRootPart.CFrame.Rotation
        local horizontalCFrame = CFrame.new(horizontalPosition) * CFrame.Angles(math.rad(90), 0, 0)
        
        -- Appliquer la position
        humanoidRootPart.CFrame = horizontalCFrame
        
        -- Ancrer pour éviter les corrections physiques
        if GroundRageConfig.Anchor then
            humanoidRootPart.Anchored = true
        end
        
        -- Forcer la synchronisation serveur
        if GroundRageConfig.ForceSync then
            humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        -- Mettre à jour l'indicateur
        local mousePos = UserInputService:GetMouseLocation()
        GroundRageStatusText.Position = Vector2.new(mousePos.X + 15, mousePos.Y + 15)
        GroundRageStatusText.Text = "Ground Rage: Actif"
        GroundRageStatusText.Color = Color3.fromRGB(0, 255, 0)
    end)
end

local function DisableGroundRage()
    GroundRageConfig.Enabled = false
    
    -- Cacher l'indicateur
    GroundRageStatusText.Visible = false
    GroundRageStatusText.Text = "Ground Rage: Inactif"
    
    local character = LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            -- Désancrer le personnage
            if GroundRageConfig.Anchor then
                humanoidRootPart.Anchored = GroundRageConfig.OriginalAnchored or false
            end
            
            -- Restaurer les collisions
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
            
            -- Restaurer le CFrame original si disponible
            if GroundRageConfig.OriginalCFrame then
                humanoidRootPart.CFrame = GroundRageConfig.OriginalCFrame
            end
        end
    end
    
    -- Nettoyer
    GroundRageConfig.OriginalCFrame = nil
    GroundRageConfig.OriginalAnchored = nil
    
    if GroundRageConfig.Connection then
        GroundRageConfig.Connection:Disconnect()
        GroundRageConfig.Connection = nil
    end
end

