local FlyKeys = {
    W = false, A = false, S = false, D = false,
    Space = false, LeftShift = false,
}

local KeyCodeMap = {
    [Enum.KeyCode.W] = "W", [Enum.KeyCode.A] = "A",
    [Enum.KeyCode.S] = "S", [Enum.KeyCode.D] = "D",
    [Enum.KeyCode.Space] = "Space", [Enum.KeyCode.LeftShift] = "LeftShift",
}

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end
    local mapped = KeyCodeMap[input.KeyCode]
    if mapped then
        FlyKeys[mapped] = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessedEvent)
    local mapped = KeyCodeMap[input.KeyCode]
    if mapped then
        FlyKeys[mapped] = false
    end
end)

local function StartFly()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    humanoidRootPart.Anchored = true
    
    if MovementConfig.Connection then
        MovementConfig.Connection:Disconnect()
    end
    
    MovementConfig.Connection = RunService.RenderStepped:Connect(function(deltaTime)
        if not MovementConfig.Fly then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        local camera = workspace.CurrentCamera
        if not camera then return end
        
        local moveDirection = Vector3.new()
        if FlyKeys.W then moveDirection += camera.CFrame.LookVector end
        if FlyKeys.S then moveDirection -= camera.CFrame.LookVector end
        if FlyKeys.A then moveDirection -= camera.CFrame.RightVector end
        if FlyKeys.D then moveDirection += camera.CFrame.RightVector end
        if FlyKeys.Space then moveDirection += Vector3.new(0, 1, 0) end
        if FlyKeys.LeftShift then moveDirection -= Vector3.new(0, 1, 0) end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        
        local newPosition = humanoidRootPart.Position + (moveDirection * MovementConfig.FlySpeed * deltaTime)
        humanoidRootPart.CFrame = CFrame.new(newPosition)
    end)
end

local function StopFly()
    if MovementConfig.Connection then
        MovementConfig.Connection:Disconnect()
        MovementConfig.Connection = nil
    end
    
    local character = LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.Anchored = false
        end
    end
end

local function StartVelocitySpeed()
    if MovementConfig.VelocityConnection then
        MovementConfig.VelocityConnection:Disconnect()
    end
    
    MovementConfig.VelocityConnection = RunService.Heartbeat:Connect(function()
        if not MovementConfig.VelocitySpeed then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        
        -- Appliquer une vélocité constante dans la direction du mouvement
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            humanoidRootPart.AssemblyLinearVelocity = moveDirection.Unit * MovementConfig.VelocitySpeedValue
        end
    end)
end

local function StopVelocitySpeed()
    if MovementConfig.VelocityConnection then
        MovementConfig.VelocityConnection:Disconnect()
        MovementConfig.VelocityConnection = nil
    end
end

