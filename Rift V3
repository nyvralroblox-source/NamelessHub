AntiKatanaGroupBox:AddToggle("AntiKatanaEnabled", {
	Text = "Activer Anti Katana",
	Default = false,
	Callback = function(Value)
		AntiKatanaConfig.Enabled = Value
		if Value then
			if AntiKatanaConfig.Connection then
				AntiKatanaConfig.Connection:Disconnect()
			end
			
			AntiKatanaConfig.Connection = RunService.Heartbeat:Connect(function()
				if not AntiKatanaConfig.Enabled then return end
				
				local character = LocalPlayer.Character
				if not character then return end
				
				local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
				if not humanoidRootPart then return end
				
				-- Détecter les joueurs avec des katanas à proximité
				for _, player in pairs(Players:GetPlayers()) do
					if player == LocalPlayer then continue end
					
					local targetCharacter = player.Character
					if not targetCharacter then continue end
					
					-- Chercher des katanas dans le personnage
					local hasKatana = false
					for _, item in pairs(targetCharacter:GetDescendants()) do
						if item.Name:lower():find("katana") or item.Name:lower():find("sword") then
							hasKatana = true
							break
						end
					end
					
					if hasKatana then
						local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
						if targetRoot then
							local distance = (targetRoot.Position - humanoidRootPart.Position).Magnitude
							
							if distance < AntiKatanaConfig.Distance then
								-- Esquiver automatiquement
								if AntiKatanaConfig.AutoDodge then
									local dodgeDirection = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)).Unit
									local dodgePosition = humanoidRootPart.Position + (dodgeDirection * 5)
									humanoidRootPart.CFrame = CFrame.new(dodgePosition)
								end
							end
						end
					end
				end
			end)
		else
			if AntiKatanaConfig.Connection then
				AntiKatanaConfig.Connection:Disconnect()
				AntiKatanaConfig.Connection = nil
			end
		end
	end,
})

