local RageBotConfig = {
	Enabled = false,
	TeamCheck = true,
	TeleportDistance = 10, -- Distance au-dessus du joueur
	MinHealth = 1, -- Santé minimale de la cible pour être valide
	TookDamage = false, -- Indicateur si on a pris des dégâts
	LastHealth = 100, -- Dernière santé connue
	OriginalCameraType = nil, -- Sauvegarder le CameraType original
	OriginalCameraCFrame = nil, -- Sauvegarder la position originale de la caméra
	RotationSpeed = 720, -- Vitesse de rotation très rapide (degrés par seconde)
	RotationRadius = 3, -- Rayon de rotation autour de la cible
	CurrentAngle = 0, -- Angle actuel de rotation
}

local RageBotConnection = nil
local RageBotStatusText = Drawing.new("Text")
RageBotStatusText.Visible = false
RageBotStatusText.Text = "Rage Bot: Inactif"
RageBotStatusText.Size = 14
RageBotStatusText.Color = Color3.fromRGB(255, 50, 50)
RageBotStatusText.Outline = true
RageBotStatusText.OutlineColor = Color3.fromRGB(0, 0, 0)
RageBotStatusText.Center = false

local function GetRageBotTarget()
	local character = LocalPlayer.Character
	if not character then return nil end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return nil end
	
	for _, player in pairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		
		local targetCharacter = player.Character
		if not targetCharacter then continue end
		
		local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end
		
		-- Health check : vérifier que la cible a assez de santé
		if humanoid.Health < RageBotConfig.MinHealth then continue end
		
		if RageBotConfig.TeamCheck then
			if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
				continue
			end
		end
		
		return player
	end
	
	return nil
end

local function RageBotCycle()
	if not RageBotConfig.Enabled then return end
	
	local character = LocalPlayer.Character
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Désancrer le personnage pour permettre le mouvement
	humanoidRootPart.Anchored = false
	
	local target = GetRageBotTarget()
	
	if target then
		-- Changer la couleur en rouge si on a pris des dégâts
		if RageBotConfig.TookDamage then
			RageBotStatusText.Text = "Rage Bot: DÉGÂTS - Téléportation vide..."
			RageBotStatusText.Color = Color3.fromRGB(255, 0, 0)
		else
			RageBotStatusText.Text = "Rage Bot: Cible trouvée - Téléportation..."
			RageBotStatusText.Color = Color3.fromRGB(50, 255, 50)
		end
		
		local targetCharacter = target.Character
		if targetCharacter then
			local targetHumanoidRootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
			if targetHumanoidRootPart then
				-- Mettre à jour l'angle de rotation très rapidement
				local deltaTime = 1/120 -- Environ 120 FPS pour mouvements ultra-rapides
				RageBotConfig.CurrentAngle = (RageBotConfig.CurrentAngle + RageBotConfig.RotationSpeed * deltaTime) % 360
				
				-- Calculer la position rotative autour de la cible
				local targetPos = targetHumanoidRootPart.Position
				local angleRad = math.rad(RageBotConfig.CurrentAngle)
				
				-- Position au-dessus avec rotation
				local offsetX = math.cos(angleRad) * RageBotConfig.RotationRadius
				local offsetZ = math.sin(angleRad) * RageBotConfig.RotationRadius
				local teleportPos = targetPos + Vector3.new(offsetX, RageBotConfig.TeleportDistance, offsetZ)
				
				-- Utiliser Humanoid:MoveTo() qui est accepté par le serveur
				humanoid:MoveTo(teleportPos)
				
				-- Orienter le personnage vers le bas
				task.wait()
				humanoidRootPart.CFrame = CFrame.new(teleportPos) * CFrame.Angles(math.rad(90), 0, 0)
			end
		end
	else
		RageBotStatusText.Text = "Rage Bot: Recherche cible..."
		RageBotStatusText.Color = Color3.fromRGB(255, 255, 50)
		-- Réinitialiser l'indicateur de dégâts quand on n'a plus de cible
		RageBotConfig.TookDamage = false
	end
end

local function EnableRageBot()
	RageBotConfig.Enabled = true
	RageBotConfig.TookDamage = false
	RageBotStatusText.Visible = true
	
	local character = LocalPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			RageBotConfig.LastHealth = humanoid.Health
		end
	end
	
	-- Sauvegarder et désynchroniser la caméra
	local camera = workspace.CurrentCamera
	if camera then
		RageBotConfig.OriginalCameraType = camera.CameraType
		RageBotConfig.OriginalCameraCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable -- Mode scriptable pour contrôle total
	end
	
	if RageBotConnection then
		RageBotConnection:Disconnect()
	end
	
	RageBotConnection = RunService.RenderStepped:Connect(function()
		local mousePos = UserInputService:GetMouseLocation()
		RageBotStatusText.Position = Vector2.new(mousePos.X + 15, mousePos.Y + 15)
		
		local cam = workspace.CurrentCamera
		if cam and RageBotConfig.OriginalCameraCFrame then
			cam.CFrame = RageBotConfig.OriginalCameraCFrame
		end
		
		if LocalPlayer.Character then
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				if hum.Health < RageBotConfig.LastHealth then
					RageBotConfig.TookDamage = true
				end
				RageBotConfig.LastHealth = hum.Health
			end
		end
		
		local ok, err = pcall(RageBotCycle)
		if not ok then
			warn("[RageBot] Erreur: " .. tostring(err))
		end
	end)
end

local function DisableRageBot()
	RageBotConfig.Enabled = false
	RageBotConfig.TookDamage = false
	RageBotStatusText.Visible = false
	RageBotStatusText.Text = "Rage Bot: Inactif"
	
	local character = LocalPlayer.Character
	if character then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			humanoidRootPart.Anchored = false
		end
	end
	
	-- Restaurer la caméra
	local camera = workspace.CurrentCamera
	if camera then
		if RageBotConfig.OriginalCameraType then
			camera.CameraType = RageBotConfig.OriginalCameraType
		end
	end
	
	if RageBotConnection then
		RageBotConnection:Disconnect()
		RageBotConnection = nil
	end
end

