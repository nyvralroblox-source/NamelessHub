-- FOV VISUEL (formes géométriques custom + dégradé animé)
--=========================================================
local FOVBox = Tabs.Visual:AddGroupbox({
    Side = "Right",
    Name = "FOV Visuel",
})

local FOVShapes = {
    ["Cercle"]    = 32,
    ["Hexagone"]  = 6,
    ["Octogone"]  = 8,
    ["Losange"]   = 4,
    ["Triangle"]  = 3,
}

local FOVSettings = {
    Enabled = false,
    Shape = "Hexagone",
    Radius = 120,
    Speed = 2,
    Color1 = Color3.fromRGB(255, 0, 120),
    Color2 = Color3.fromRGB(0, 180, 255),
}

-- Nombre de tranches utilisées pour le REMPLISSAGE (indépendant du nombre de
-- coins de la forme) : plus c'est élevé, plus le dégradé paraît lisse et
-- continu au lieu d'être visiblement découpé en facettes.
local FOV_FILL_SEGMENTS = 72

local FOVQuads = {}
local FOVOutline = {}
local FOVConnection = nil

local function ClearFOVDrawings()
    for _, quad in ipairs(FOVQuads) do
        quad:Remove()
    end
    FOVQuads = {}

    for _, line in ipairs(FOVOutline) do
        line:Remove()
    end
    FOVOutline = {}
end

local function BuildFOVDrawings(sides)
    ClearFOVDrawings()

    -- Remplissage : toujours FOV_FILL_SEGMENTS tranches fines, peu importe
    -- la forme, pour un dégradé lisse
    for _ = 1, FOV_FILL_SEGMENTS do
        local quad = Drawing.new("Quad")
        quad.Filled = true
        quad.Thickness = 1
        quad.Visible = false
        table.insert(FOVQuads, quad)
    end

    -- Contour : suit le vrai nombre de coins de la forme choisie
    for _ = 1, sides do
        local line = Drawing.new("Line")
        line.Thickness = 2
        line.Visible = false
        table.insert(FOVOutline, line)
    end
end

local function LerpColor(c1, c2, t)
    return Color3.new(
        c1.R + (c2.R - c1.R) * t,
        c1.G + (c2.G - c1.G) * t,
        c1.B + (c2.B - c1.B) * t
    )
end

-- Retourne un point sur le pourtour du polygone (défini par "corners") à la
-- fraction "t" (0 à 1) du périmètre total. Permet un échantillonnage fin
-- indépendant du nombre de coins, pour un dégradé lisse le long du contour.
local function GetPointOnPerimeter(corners, cumulativeLengths, totalLength, t)
    local targetDist = t * totalLength
    local n = #corners

    for i = 1, n do
        local segStart = cumulativeLengths[i]
        local segEnd = cumulativeLengths[i + 1]
        if targetDist <= segEnd or i == n then
            local segLen = segEnd - segStart
            local alpha = segLen > 0 and (targetDist - segStart) / segLen or 0
            local p1 = corners[i]
            local p2 = corners[(i % n) + 1]
            return p1:Lerp(p2, alpha)
        end
    end

    return corners[1]
end

local function StartFOVLoop()
    if FOVConnection then
        FOVConnection:Disconnect()
        FOVConnection = nil
    end

    local sides = FOVShapes[FOVSettings.Shape]
    BuildFOVDrawings(sides)

    local t0 = tick()

    FOVConnection = RunService.RenderStepped:Connect(function()
        if not FOVSettings.Enabled then return end

        local mouseLoc = UserInputService:GetMouseLocation()
        local cx, cy = mouseLoc.X, mouseLoc.Y
        local radius = FOVSettings.Radius
        local elapsed = tick() - t0
        local phase = (elapsed * FOVSettings.Speed) % 1
        local center = Vector2.new(cx, cy)

        -- Coins réels de la forme (pour le contour)
        local corners = {}
        for i = 0, sides - 1 do
            local angle = (i / sides) * math.pi * 2 - math.pi / 2
            corners[i + 1] = Vector2.new(
                cx + math.cos(angle) * radius,
                cy + math.sin(angle) * radius
            )
        end

        -- Longueurs cumulées du périmètre (pour échantillonner uniformément)
        local cumulativeLengths = { [1] = 0 }
        local totalLength = 0
        for i = 1, sides do
            local p1 = corners[i]
            local p2 = corners[(i % sides) + 1]
            totalLength = totalLength + (p2 - p1).Magnitude
            cumulativeLengths[i + 1] = totalLength
        end

        -- Contour (lignes suivant les vrais coins)
        for i = 1, sides do
            local p1 = corners[i]
            local p2 = corners[(i % sides) + 1]
            local t = ((i / sides) + phase) % 1
            local color = LerpColor(FOVSettings.Color1, FOVSettings.Color2, (math.sin(t * math.pi * 2) + 1) / 2)

            local line = FOVOutline[i]
            line.From = p1
            line.To = p2
            line.Color = color
            line.Transparency = 0
            line.Visible = true
        end

        -- Remplissage : dégradé lisse à 40% d'opacité (Transparency = 0.6)
        for i = 1, FOV_FILL_SEGMENTS do
            local t1 = (i - 1) / FOV_FILL_SEGMENTS
            local t2 = i / FOV_FILL_SEGMENTS

            local p1 = GetPointOnPerimeter(corners, cumulativeLengths, totalLength, t1)
            local p2 = GetPointOnPerimeter(corners, cumulativeLengths, totalLength, t2)

            local colorT = ((t1 + t2) / 2 + phase) % 1
            local color = LerpColor(FOVSettings.Color1, FOVSettings.Color2, (math.sin(colorT * math.pi * 2) + 1) / 2)

            local quad = FOVQuads[i]
            quad.PointA = center
            quad.PointB = center
            quad.PointC = p1
            quad.PointD = p2
            quad.Color = color
            quad.Transparency = 0.6 -- 40% d'opacité
            quad.Visible = true
        end
    end)
end

local function StopFOVLoop()
    if FOVConnection then
        FOVConnection:Disconnect()
        FOVConnection = nil
    end
    ClearFOVDrawings()
end

