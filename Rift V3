-- Fonction pour forcer la synchronisation serveur
local function ForceServerSync(character, targetPosition)
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    if KnifeRageConfig.ForceSync then
        if targetPosition then
            humanoidRootPart.CFrame = CFrame.new(targetPosition, targetPosition + Vector3.new(0, 10, 0))
        end
        
        humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end

local function GetKnifeRageTarget()
    local target = nil
    local closestDistance = 100000
    local character = LocalPlayer.Character
    
    if not character then return nil end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return nil end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local targetCharacter = player.Character
        if not targetCharacter then continue end
        
        local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        
        if humanoid.Health < KnifeRageConfig.MinHealth then continue end
        
        if KnifeRageConfig.TeamCheck then
            if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                continue
            end
        end
        
        local targetPart = targetCharacter:FindFirstChild(KnifeRageConfig.TargetPart)
        if not targetPart then
            targetPart = targetCharacter:FindFirstChild("HumanoidRootPart")
        end
        if not targetPart then continue end
        
        local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
        
        if distance < closestDistance then
            closestDistance = distance
            target = targetPart
        end
    end
    
    return target
end

local function KnifeRageCycle()
    if not KnifeRageConfig.Enabled then return end
    
    if not LocalPlayer.Character then return end
    
    local humanoidRootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local currentTime = tick()
    
    local phaseText = ""
    if KnifeRageCurrentPhase == "idle" then
        phaseText = "Recherche cible..."
    elseif KnifeRageCurrentPhase == "orient" then
        phaseText = "Orientation"
    elseif KnifeRageCurrentPhase == "approach" then
        phaseText = "Approche"
    elseif KnifeRageCurrentPhase == "attack" then
        phaseText = "Attaque"
    elseif KnifeRageCurrentPhase == "cooldown" then
        local timeRemaining = math.ceil(KnifeRageConfig.AttackCooldown - (currentTime - KnifeRageTimer))
        phaseText = "Cooldown (" .. timeRemaining .. "s)"
    end
    
    KnifeRageStatusText.Text = "Knife Rage: " .. phaseText .. " | Kills: " .. KnifeRageCycleCount
    
    if KnifeRageCurrentPhase == "idle" then
        KnifeRageTarget = GetKnifeRageTarget()
        
        if KnifeRageTarget then
            KnifeRageCurrentPhase = "orient"
            KnifeRageTimer = currentTime
        end
    
    elseif KnifeRageCurrentPhase == "orient" then
        if KnifeRageTarget and KnifeRageTarget.Parent then
            local targetPosition = KnifeRageTarget.Position
            
            -- Orienter le personnage vers la cible SANS CHANGER LA POSITION
            humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position, targetPosition)
            
            -- NE PAS ANCRER - permettre le mouvement pour l'approche
            
            -- Force synchronisation serveur pour l'orientation
            if KnifeRageConfig.ForceSync then
                humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
            
            -- Passer à l'approche après un court délai
            if currentTime - KnifeRageTimer >= 0.05 then
                KnifeRageCurrentPhase = "approach"
                KnifeRageTimer = currentTime
            end
        else
            KnifeRageCurrentPhase = "idle"
        end
    
    elseif KnifeRageCurrentPhase == "approach" then
        if KnifeRageTarget and KnifeRageTarget.Parent then
            local targetPosition = KnifeRageTarget.Position
            local targetCFrame = KnifeRageTarget.CFrame
            
            -- Calculer la position derrière la cible
            local behindOffset = targetCFrame.LookVector * -KnifeRageConfig.ApproachDistance
            local behindPosition = targetPosition + behindOffset + Vector3.new(0, 0, 0)
            
            humanoid:MoveTo(behindPosition)
            task.wait()
            
            -- Téléporter EN MAINTENANT l'orientation vers la cible
            humanoidRootPart.CFrame = CFrame.new(behindPosition, targetPosition)
            
            -- SAUVEGARDER la position sécurisée
            KnifeRageConfig.SafePosition = behindPosition
            
            -- Ancrer après téléportation pour éviter les déplacements
            humanoidRootPart.Anchored = true
            
            -- Force synchronisation serveur pour la position et l'orientation
            if KnifeRageConfig.ForceSync then
                humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
            
            KnifeRageCurrentPhase = "attack"
            KnifeRageTimer = currentTime
        else
            KnifeRageCurrentPhase = "idle"
        end
    
    elseif KnifeRageCurrentPhase == "attack" then
        if KnifeRageTarget and KnifeRageTarget.Parent then
            local targetPosition = KnifeRageTarget.Position
            local targetCFrame = KnifeRageTarget.CFrame
            
            -- Se positionner derrière la cible EN MAINTENANT l'orientation
            local behindOffset = targetCFrame.LookVector * -KnifeRageConfig.ApproachDistance
            local behindPosition = targetPosition + behindOffset
            
            -- MAINTENIR LA POSITION ACTUELLE, SEULEMENT L'ORIENTATION
            humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position, targetPosition)
            
            -- Garder ancré pour éviter les téléportations
            humanoidRootPart.Anchored = true
            
            -- Simuler le clic droit (attaque au couteau)
            SimulateRightClick()
            
            -- Maintenir l'orientation pendant l'attaque
            if KnifeRageConfig.ForceSync then
                humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
        
        if currentTime - KnifeRageTimer >= KnifeRageConfig.EngagementTime then
            KnifeRageCurrentPhase = "cooldown"
            KnifeRageTimer = currentTime
            KnifeRageCycleCount = KnifeRageCycleCount + 1
        end
    
    elseif KnifeRageCurrentPhase == "cooldown" then
        -- MAINTENIR LA POSITION ACTUELLE - AUCUN CHANGEMENT DE POSITION
        -- Ancrer pour empêcher tout mouvement et téléportation
        humanoidRootPart.Anchored = true
        
        -- S'assurer qu'aucune vélocité ne cause des déplacements
        if KnifeRageConfig.ForceSync then
            humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        if currentTime - KnifeRageTimer >= KnifeRageConfig.AttackCooldown then
            KnifeRageCurrentPhase = "idle"
            humanoidRootPart.Anchored = false
        end
    end
end

local function EnableKnifeRage()
    KnifeRageConfig.Enabled = true
    KnifeRageCurrentPhase = "idle"
    KnifeRageTarget = nil
    KnifeRageCycleCount = 0
    
    KnifeRageStatusText.Visible = true
    
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            KnifeRageOriginalWalkSpeed = humanoid.WalkSpeed
            humanoid.WalkSpeed = KnifeRageConfig.WalkSpeed
        end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.Anchored = false -- S'assurer qu'il n'est pas ancré au démarrage
        end
    end
    
    local camera = workspace.CurrentCamera
    if camera then
        KnifeRageConfig.OriginalCameraType = camera.CameraType
        KnifeRageConfig.OriginalCameraCFrame = camera.CFrame
        camera.CameraType = Enum.CameraType.Scriptable
    end
    
    if KnifeRageConfig.Connection then
        KnifeRageConfig.Connection:Disconnect()
    end
    
    KnifeRageConfig.Connection = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if camera then
            KnifeRageStatusText.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y - 60)
        end
        
        if camera and KnifeRageConfig.OriginalCameraCFrame then
            camera.CFrame = KnifeRageConfig.OriginalCameraCFrame
        end
        
        local ok, err = pcall(KnifeRageCycle)
        if not ok then
            warn("[KnifeRage] Erreur: " .. tostring(err))
        end
    end)
end

local function DisableKnifeRage()
    KnifeRageConfig.Enabled = false
    KnifeRageCurrentPhase = "idle"
    KnifeRageTarget = nil
    KnifeRageCycleCount = 0
    
    -- S'assurer que le personnage n'est plus ancré
    local character = LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.Anchored = false
        end
    end
    
    KnifeRageStatusText.Visible = false
    KnifeRageStatusText.Text = "Knife Rage: Inactif"
    
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and KnifeRageOriginalWalkSpeed then
            humanoid.WalkSpeed = KnifeRageOriginalWalkSpeed
        end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.Anchored = false
        end
    end
    
    local camera = workspace.CurrentCamera
    if camera then
        if KnifeRageConfig.OriginalCameraType then
            camera.CameraType = KnifeRageConfig.OriginalCameraType
        end
    end
    
    if KnifeRageConfig.Connection then
        KnifeRageConfig.Connection:Disconnect()
        KnifeRageConfig.Connection = nil
    end
end

