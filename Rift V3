local function StartSwapOnLowAmmo()
    if MiscConfig.SwapConnection then
        MiscConfig.SwapConnection:Disconnect()
    end
    
    MiscConfig.SwapConnection = RunService.Heartbeat:Connect(function()
        if not MiscConfig.SwapOnLowAmmo then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        -- Chercher les munitions dans le personnage
        for _, item in pairs(character:GetDescendants()) do
            if item:IsA("IntValue") and (item.Name:lower():find("ammo") or item.Name:lower():find("bullet")) then
                if item.Value <= MiscConfig.LowAmmoThreshold then
                    -- Swap automatiquement d'arme
                    local player = LocalPlayer
                    local backpack = player:FindFirstChild("Backpack")
                    if backpack then
                        -- Trouver une autre arme
                        for _, tool in pairs(backpack:GetChildren()) do
                            if tool:IsA("Tool") and tool ~= character:FindFirstChildOfClass("Tool") then
                                -- Équiper l'autre arme
                                local humanoid = character:FindFirstChildOfClass("Humanoid")
                                if humanoid then
                                    humanoid:EquipTool(tool)
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function StopSwapOnLowAmmo()
    if MiscConfig.SwapConnection then
        MiscConfig.SwapConnection:Disconnect()
        MiscConfig.SwapConnection = nil
    end
end

