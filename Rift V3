local function EnableNoMuzzleFlash()
    -- Supprimer les effets de flash des armes
    local character = LocalPlayer.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part.Name:lower():find("flash") or part.Name:lower():find("muzzle") then
                if part:IsA("BasePart") then
                    part.Transparency = 1
                elseif part:IsA("PointLight") or part:IsA("SpotLight") then
                    part.Enabled = false
                end
            end
        end
    end
end

local function DisableNoMuzzleFlash()
    -- Restaurer les effets de flash
    local character = LocalPlayer.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part.Name:lower():find("flash") or part.Name:lower():find("muzzle") then
                if part:IsA("BasePart") then
                    part.Transparency = 0
                elseif part:IsA("PointLight") or part:IsA("SpotLight") then
                    part.Enabled = true
                end
            end
        end
    end
end

local function EnableNoBobbing()
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            VisualEffectsConfig.OriginalWalkOffset = humanoid.WalkOffset
