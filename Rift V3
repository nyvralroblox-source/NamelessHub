local ModsConfig = {
    MeshFistEnabled = false,
    WireframeColor = Color3.fromRGB(0, 255, 255),
    Transparency = 0.7,
    OriginalLeftHandMesh = nil,
    OriginalRightHandMesh = nil,
    LeftHandWireframe = nil,
    RightHandWireframe = nil,
    Connection = nil,
}

local function CreateWireframeMesh(part, color)
    -- Créer un wireframe optimisé sans perdre de FPS
    local wireframe = Instance.new("SpecialMesh")
    wireframe.MeshType = Enum.MeshType.FileMesh
    wireframe.TextureId = ""
    wireframe.Color3 = color
    wireframe.Transparency = ModsConfig.Transparency
    
    -- Utiliser les propriétés optimisées pour éviter la perte de FPS
    wireframe.RenderFidelity = Enum.RenderFidelity.Performance
    
    return wireframe
end

local function ApplyMeshToPart(part, meshId, isWireframe)
    if not part then return false end
    
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.Parent = part
    end
    
    -- Supprimer les anciens meshs wireframes
    for _, child in pairs(part:GetChildren()) do
        if child:IsA("SpecialMesh") and child ~= mesh then
            child:Destroy()
        end
    end
    
    mesh.MeshId = "rbxassetid://12307734932, 12307583853" .. meshId
    mesh.MeshType = Enum.MeshType.FileMesh
    
    if isWireframe then
        mesh.Transparency = 0.3
        mesh.Color3 = ModsConfig.WireframeColor
    else
        mesh.Transparency = ModsConfig.Transparency
    end
    
    mesh.RenderFidelity = Enum.RenderFidelity.Performance
    
    return true
end

local function ApplyMeshFist()
    local character = LocalPlayer.Character
    if not character then 
        warn("[MeshFist] Personnage non trouvé")
        return 
    end
    
    -- Approche différente : créer des parties personnalisées pour les meshs
    local leftHandMesh = character:FindFirstChild("LeftHandMesh")
    local rightHandMesh = character:FindFirstChild("RightHandMesh")
    
    -- Créer les parties de mesh si elles n'existent pas
    if not leftHandMesh then
        leftHandMesh = Instance.new("Part")
        leftHandMesh.Name = "LeftHandMesh"
        leftHandMesh.Size = Vector3.new(1, 1, 1)
        leftHandMesh.Transparency = 1
        leftHandMesh.CanCollide = false
        leftHandMesh.Anchored = true
        leftHandMesh.Parent = character
        print("[MeshFist] Création partie main gauche")
    end
    
    if not rightHandMesh then
        rightHandMesh = Instance.new("Part")
        rightHandMesh.Name = "RightHandMesh"
        rightHandMesh.Size = Vector3.new(1, 1, 1)
        rightHandMesh.Transparency = 1
        rightHandMesh.CanCollide = false
        rightHandMesh.Anchored = true
        rightHandMesh.Parent = character
        print("[MeshFist] Création partie main droite")
    end
    
    -- Attacher les meshs aux mains existantes pour le suivi
    local actualLeftHand = character:FindFirstChild("LeftHand") or character:FindFirstChild("leftHand") or character:FindFirstChild("Left Arm")
    local actualRightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("rightHand") or character:FindFirstChild("Right Arm")
    
    -- Appliquer le mesh à la partie personnalisée main gauche
    local leftMesh = leftHandMesh:FindFirstChildOfClass("SpecialMesh")
    if not leftMesh then
        leftMesh = Instance.new("SpecialMesh")
        leftMesh.Parent = leftHandMesh
    end
    
    leftMesh.MeshId = "rbxassetid://12307734932"
    leftMesh.MeshType = Enum.MeshType.FileMesh
    leftMesh.Transparency = ModsConfig.Transparency
    leftMesh.Color3 = ModsConfig.WireframeColor
    leftMesh.RenderFidelity = Enum.RenderFidelity.Performance
    print("[MeshFist] Mesh 12307734932 appliqué")
    
    -- Appliquer le mesh à la partie personnalisée main droite
    local rightMesh = rightHandMesh:FindFirstChildOfClass("SpecialMesh")
    if not rightMesh then
        rightMesh = Instance.new("SpecialMesh")
        rightMesh.Parent = rightHandMesh
    end
    
    rightMesh.MeshId = "rbxassetid://12307583853"
    rightMesh.MeshType = Enum.MeshType.FileMesh
    rightMesh.Transparency = ModsConfig.Transparency
    rightMesh.Color3 = ModsConfig.WireframeColor
    rightMesh.RenderFidelity = Enum.RenderFidelity.Performance
    print("[MeshFist] Mesh 12307583853 appliqué")
    
    -- Créer un suivi pour positionner les meshs sur les mains réelles
    if actualLeftHand and actualRightHand then
        if ModsConfig.Connection then
            ModsConfig.Connection:Disconnect()
        end
        
        ModsConfig.Connection = RunService.RenderStepped:Connect(function()
            if not ModsConfig.MeshFistEnabled then return end
            
            if actualLeftHand and leftHandMesh then
                leftHandMesh.CFrame = actualLeftHand.CFrame
            end
            
            if actualRightHand and rightHandMesh then
                rightHandMesh.CFrame = actualRightHand.CFrame
            end
        end)
    else
        warn("[MeshFist] Mains réelles non trouvées pour le suivi")
    end
end

local function RemoveMeshFist()
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Supprimer les parties personnalisées
    local leftHandMesh = character:FindFirstChild("LeftHandMesh")
    if leftHandMesh then
        leftHandMesh:Destroy()
    end
    
    local rightHandMesh = character:FindFirstChild("RightHandMesh")
    if rightHandMesh then
        rightHandMesh:Destroy()
    end
    
    -- Nettoyer les wireframes
    if ModsConfig.LeftHandWireframe then
        ModsConfig.LeftHandWireframe:Destroy()
        ModsConfig.LeftHandWireframe = nil
    end
    
    if ModsConfig.RightHandWireframe then
        ModsConfig.RightHandWireframe:Destroy()
        ModsConfig.RightHandWireframe = nil
    end
end

local function EnableMeshFist()
    ModsConfig.MeshFistEnabled = true
    ApplyMeshFist()
    
    -- Surveiller les changements de personnage
    if ModsConfig.Connection then
        ModsConfig.Connection:Disconnect()
    end
    
    ModsConfig.Connection = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1) -- Attendre que le personnage soit chargé
        if ModsConfig.MeshFistEnabled then
            ApplyMeshFist()
        end
    end)
end

local function DisableMeshFist()
    ModsConfig.MeshFistEnabled = false
    RemoveMeshFist()
    
    if ModsConfig.Connection then
        ModsConfig.Connection:Disconnect()
        ModsConfig.Connection = nil
    end
end

