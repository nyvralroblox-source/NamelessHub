local GroundSpamConfig = {
	Enabled = false,
	Depth = 2, -- Profondeur dans le sol (réduite pour éviter la mort)
	StretchAmount = 2, -- Facteur d'allongement
	LookAtSky = true, -- Regarder vers le ciel
	PreventDeath = true, -- Empêcher la mort
	ForceSync = true, -- Forcer la synchronisation serveur
	SyncDelay = 0.016, -- Délai pour synchronisation serveur
	Anchor = true, -- Ancrer le personnage pour éviter de tomber
	OriginalWalkSpeed = nil,
	OriginalJumpPower = nil,
	LockedPosition = nil, -- Position verrouillée dans le sol
	LockedCFrame = nil, -- CFrame verrouillé
}

local GroundSpamConnection = nil
local GroundSpamOriginalTransparency = {}
local GroundSpamOriginalSize = {}

local function EnableGroundSpam()
	GroundSpamConfig.Enabled = true
	
	local character = LocalPlayer.Character
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	-- Calculer et verrouiller la position dans le sol UNE SEULE FOIS
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {character}
	
	local rayResult = workspace:Raycast(humanoidRootPart.Position, Vector3.new(0, -50, 0), rayParams)
	local groundPosition = humanoidRootPart.Position
	
	if rayResult then
		groundPosition = rayResult.Position - Vector3.new(0, GroundSpamConfig.Depth, 0)
	else
		groundPosition = humanoidRootPart.Position - Vector3.new(0, GroundSpamConfig.Depth, 0)
	end
	
	-- Verrouiller la position et le CFrame
	GroundSpamConfig.LockedPosition = groundPosition
	GroundSpamConfig.LockedCFrame = CFrame.new(groundPosition) * CFrame.Angles(math.rad(-90), 0, 0)
	
	print("[GroundSpam] Position verrouillée: " .. tostring(groundPosition))
	
	-- Sauvegarder les propriétés originales
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			GroundSpamOriginalTransparency[part] = part.Transparency
			GroundSpamOriginalSize[part] = part.Size
		end
	end
	
	-- Sauvegarder les propriétés du humanoid
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		GroundSpamConfig.OriginalWalkSpeed = humanoid.WalkSpeed
		GroundSpamConfig.OriginalJumpPower = humanoid.JumpPower
		humanoid.JumpPower = 0
		humanoid.WalkSpeed = 0
	end
	
	-- Appliquer immédiatement le verrouillage
	humanoidRootPart.CFrame = GroundSpamConfig.LockedCFrame
	humanoidRootPart.Anchored = true
	
	if GroundSpamConnection then
		GroundSpamConnection:Disconnect()
	end
	
	-- Verrouillage agressif avec Heartbeat (plus fréquent que RenderStepped)
	GroundSpamConnection = RunService.Heartbeat:Connect(function()
		if not GroundSpamConfig.Enabled then return end
		
		local character = LocalPlayer.Character
		if not character then return end
		
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if not humanoidRootPart then return end
		
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		-- PRIORITÉ ABSOLUE: Empêcher la mort
		if GroundSpamConfig.PreventDeath then
			if humanoid.Health <= 0 then
				humanoid.Health = 100
			elseif humanoid.Health < 25 then
				humanoid.Health = 100
			end
		end
		
		-- Verrouillage positionnel AGRESSIF - forcer la position verrouillée
		humanoidRootPart.CFrame = GroundSpamConfig.LockedCFrame
		humanoidRootPart.Anchored = true
		
		-- Noclip total
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
		
		-- Synchronisation serveur agressive
		if GroundSpamConfig.ForceSync then
			humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
		end
		
		-- Maintenir les dimensions
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local originalSize = GroundSpamOriginalSize[part]
				if originalSize then
					part.Size = Vector3.new(originalSize.X, originalSize.Y * GroundSpamConfig.StretchAmount, originalSize.Z)
				end
			end
		end
		
		-- Triple vérification anti-mort
		if GroundSpamConfig.PreventDeath then
			humanoid.Health = math.max(humanoid.Health, 75)
		end
	end)
end

local function DisableGroundSpam()
	GroundSpamConfig.Enabled = false
	
	-- Libérer le verrouillage positionnel
	GroundSpamConfig.LockedPosition = nil
	GroundSpamConfig.LockedCFrame = nil
	
	local character = LocalPlayer.Character
	if character then
		-- Désancrer le personnage
		if GroundSpamConfig.Anchor then
			local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			if humanoidRootPart then
				humanoidRootPart.Anchored = false
			end
		end
		
		-- Restaurer les collisions
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
				
				-- Restaurer la taille originale
				if GroundSpamOriginalSize[part] then
					part.Size = GroundSpamOriginalSize[part]
				end
				
				-- Restaurer la transparence originale
				if GroundSpamOriginalTransparency[part] then
					part.Transparency = GroundSpamOriginalTransparency[part]
				end
			end
		end
		
		-- Restaurer les propriétés du humanoid
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if GroundSpamConfig.OriginalWalkSpeed then
				humanoid.WalkSpeed = GroundSpamConfig.OriginalWalkSpeed
			end
			if GroundSpamConfig.OriginalJumpPower then
				humanoid.JumpPower = GroundSpamConfig.OriginalJumpPower
			end
		end
	end
	
	-- Nettoyer les tables
	GroundSpamOriginalTransparency = {}
	GroundSpamOriginalSize = {}
	GroundSpamConfig.OriginalWalkSpeed = nil
	GroundSpamConfig.OriginalJumpPower = nil
	GroundSpamConfig.LockedPosition = nil
	GroundSpamConfig.LockedCFrame = nil
	
	if GroundSpamConnection then
		GroundSpamConnection:Disconnect()
		GroundSpamConnection = nil
	end
end

