    SafePosition = nil, -- Position sécurisée pendant le cooldown
}

local KnifeRageCurrentPhase = "idle" -- idle, orient, approach, attack, cooldown
local KnifeRageTarget = nil
local KnifeRageTimer = 0
local KnifeRageLastAttackTime = 0
local KnifeRageCycleCount = 0
local KnifeRageOriginalWalkSpeed = nil

-- Indicateur d'état
